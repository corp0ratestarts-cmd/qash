### G.3 Composition Security Theorem

```coq
(* Theorem: Cascade composition preserves collision resistance *)
Theorem cascade_composition_collision_resistance :
  forall (cfg : CascadeConfig) (input1 input2 : list byte),
    cfg_depth_valid cfg →
    domain_separators_unique cfg →
    (∃ p ∈ cfg_primitives cfg, prim_collision_resistant p) →
    (∃ p ∈ cfg_primitives cfg, prim_family_distinct p) →  (* ≥2 mathematical families *)
    execute_cascade_layer input1 (cfg_depth cfg) cfg = 
    execute_cascade_layer input2 (cfg_depth cfg) cfg →
    input1 = input2.
Proof.
  intros cfg input1 input2 H_depth H_domains H_coll_resist H_families H_eq.
  
  (* Proof strategy: induction on cascade depth *)
  generalize dependent input2.
  induction (cfg_depth cfg) as [d IH]; intros input2 H_exec_eq.
  
  - (* Base case: depth = 0 (Level 1 parallel only) *)
    unfold execute_cascade_layer in H_exec_eq.
    (* If parallel outputs are equal, at least one collision-resistant primitive 
       implies inputs must be equal *)
    apply parallel_outputs_injective in H_exec_eq.
    + apply H_coll_resist; assumption.
    + apply domain_separators_unique; assumption.
  
  - (* Inductive step: depth = S d *)
    (* Key lemma: binding primitive propagates differences via avalanche *)
    assert (H_avalanche : cascade_avalanche_property cfg).
    { apply binding_primitive_avalanche; apply cfg_binding_prim_valid; assumption. }
    
    (* If final outputs equal, previous layer outputs must be equal *)
    apply cascade_layer_injective in H_exec_eq.
    + apply IH; assumption.
    + apply H_avalanche.
    + apply domain_separators_unique; assumption.
Qed.
