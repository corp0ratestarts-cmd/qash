```rust
// Reuse existing h_domain for SHA3 family
fn h_domain(tag: DomainTag, epoch_seed: &[u8; 32], epoch: u64, validator_id: u64) -> [u8; 32] {
    let mut input = Vec::with_capacity(48);
    input.extend_from_slice(epoch_seed);
    input.extend_from_slice(&epoch.to_le_bytes());
    input.extend_from_slice(&validator_id.to_le_bytes());
    crate::hash::h_domain(tag, &input)
}

// BLAKE3 variant (domain-separated)
fn h_domain_blake3(tag: DomainTag, epoch_seed: &[u8; 32], epoch: u64, validator_id: u64) -> [u8; 32] {
    let mut input = Vec::with_capacity(48 + 4);
    input.extend_from_slice(&(tag as u8).to_le_bytes());  // Domain separation
    input.extend_from_slice(epoch_seed);
    input.extend_from_slice(&epoch.to_le_bytes());
    input.extend_from_slice(&validator_id.to_le_bytes());
    blake3::hash(&input).into()
}

// KangarooTwelve variant (domain-separated, 32-byte output)
fn h_domain_k12(tag: DomainTag, epoch_seed: &[u8; 32], epoch: u64, validator_id: u64) -> [u8; 32] {
    let mut input = Vec::with_capacity(48 + 4);
    input.extend_from_slice(&(tag as u8).to_le_bytes());
    input.extend_from_slice(epoch_seed);
    input.extend_from_slice(&epoch.to_le_bytes());
    input.extend_from_slice(&validator_id.to_le_bytes());
    k12::k12(&input, b"", 32).as_slice().try_into().unwrap()
}

// SM3 variant (reuse existing implementation from crypto/sm3.rs)
fn h_domain_sm3(tag: DomainTag, epoch_seed: &[u8; 32], epoch: u64, validator_id: u64) -> [u8; 32] {
    use crate::crypto::sm3::sm3_256;
    let mut input = Vec::with_capacity(48 + 4);
    input.extend_from_slice(&(tag as u8).to_le_bytes());
    input.extend_from_slice(epoch_seed);
    input.extend_from_slice(&epoch.to_le_bytes());
    input.extend_from_slice(&validator_id.to_le_bytes());
    sm3_256(&input)
}

// Streebog variant (reuse existing implementation from crypto/streebog.rs)
fn h_domain_streebog(tag: DomainTag, epoch_seed: &[u8; 32], epoch: u64, validator_id: u64) -> [u8; 32] {
    use crate::crypto::streebog::streebog_256;
    let mut input = Vec::with_capacity(48 + 4);
    input.extend_from_slice(&(tag as u8).to_le_bytes());
    input.extend_from_slice(epoch_seed);
    input.extend_from_slice(&epoch.to_le_bytes());
    input.extend_from_slice(&validator_id.to_le_bytes());
    streebog_256(&input)
}
```

