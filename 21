        let path = derive_oram_path(logical_addr, self.access_counter, &self.config.seed);
        
        // 2. Read entire path (real + dummy buckets)
        let path_entries = self.read_path(&path)?;
        
        // 3. Find target entry (constant-time search)
        let target = constant_time_find_entry(&path_entries, logical_addr, &self.stash)?;
        
        // 4. Re-encrypt and re-randomize position (deterministic re-randomization)
        let new_position = derive_new_position(logical_addr, self.access_counter, &self.config.seed);
        self.position_map.update(logical_addr, new_position);
        
        // 5. Write back path with updated entry (oblivious write)
        self.write_path(&path, path_entries)?;
        
        // 6. Increment counter deterministically
        self.access_counter = self.access_counter.wrapping_add(1);
        
        Ok(target.value)
