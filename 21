    pub primitives: Vec<HashPrimitive>,
    pub depth: u8,                    // 3..=15 (genesis-pinned)
    pub composition_mode: CompositionMode,
    pub binding_primitive: HashPrimitive,
    pub domain_separators: [[u8; 32]; 15],  // One per max depth
}

pub enum CompositionMode {
    ParallelOnly,      // Level 1 only, no binding
    RecursiveBinding,  // Each layer binds previous output + new primitive
    MerkleTree,        // Level-1 outputs form leaves of Merkle tree
}

pub fn execute_astronomical_cascade(
    input: &[u8],
    config: &CascadeConfig,
) -> Result<[u8; 32], CascadeError> {
    // Level 1: Parallel primitive execution
    let level1_outputs: Vec<[u8; 32]> = config.primitives
        .iter()
        .map(|prim| prim.hash_with_domain(input, &config.domain_separators[0]))
        .collect::<Result<_, _>>()?;
    
    // Level 2: Cross-primitive binding
    let mut current = config.binding_primitive.hash_concat(
        &level1_outputs.iter().flatten().collect::<Vec<_>>(),
        &config.domain_separators[1]
    )?;
    
    // Levels 3..N: Recursive expansion (if depth > 2)
    for layer in 2..config.depth {
        let layer_seed = derive_layer_seed(input, layer);  // Deterministic, epoch-bound
        let primitive = &config.primitives[layer % config.primitives.len()];
        
        current = primitive.hash_with_domain(
            &[current.as_slice(), layer_seed.as_slice()].concat(),
            &config.domain_separators[layer as usize]
        )?;
    }
    
    Ok(current)
}

/// Derive deterministic layer seed from input + layer index
fn derive_layer_seed(input: &[u8], layer: u8) -> [u8; 32] {
    // Use a dedicated, non-cascade hash for seed derivation to avoid circularity
    blake3::hash(&[b"QASH:CASCADE:SEED", &[layer], input].concat()).into()
}
