            verify_sampled_layers(&proof.layer_commitments, expected_input, &layers, config)
        }
        VerificationStrategy::BindingOnly => {
            // Verify Level-1 primitive outputs + Level-2 binding only
            verify_binding_only(&proof, expected_input, config)
        }
        VerificationStrategy::ReceiptTrust => {
            // Trust receipt from attested higher-tier validator (with Merkle proof)
