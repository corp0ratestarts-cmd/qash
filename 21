const AES_DM_FIXED_KEY: [u8; 32] = *b"QASH:AES:DM:KEY:2026:GENESIS:FIXED";

/// Davies-Meyer hash using AES-256
/// Security: Collision-resistant under Ideal Cipher Model
pub fn hash_aes_dm(input: &[u8], domain: &[u8; 32]) -> [u8; 32] {
    // 1. Domain-separated, padded input (256-bit aligned)
    let mut block = [0u8; 32];
    block[..domain.len()].copy_from_slice(domain);
