### 3.7.3 Deterministic Blinding Execution

**Critical Constraint**: Blinding must be **deterministic across validators** to preserve consensus — randomness is derived from epoch-bound PRFs, not true random sources.

```rust
/// Execute a blinded cryptographic operation
pub fn execute_blinded_operation<T, F, R>(
    operation: F,
    requirement: &BlindingRequirement,
    context: &BlindingContext,
) -> Result<T, BlindingError>
where
    F: FnOnce(BlindedInput) -> Result<T, R>,
    R: std::error::Error,
{
    // 1. Derive deterministic blinding parameters
    let blinding_params = derive_blinding_params(requirement, context)?;
    
    // 2. Apply blinding to inputs
    let blinded_input = apply_blinding(operation.input(), &blinding_params)?;
    
    // 3. Execute operation in blinded context
    let blinded_result = operation(blinded_input)
        .map_err(BlindingError::OperationFailed)?;
    
    // 4. Remove blinding from output (if applicable)
    let result = unblind_output(blinded_result, &blinding_params)?;
    
    // 5. Verify blinding integrity (constant-time check)
    verify_blinding_integrity(&blinding_params, context)?;
    
    Ok(result)
}

/// Derive deterministic blinding parameters from epoch-bound context
fn derive_blinding_params(
    requirement: &BlindingRequirement,
    context: &BlindingContext,
) -> Result<BlindingParams, BlindingError> {
    match &requirement.mode {
        BlindingMode::Multiplicative { blinding_field, randomness_source } => {
            let r = derive_blinding_scalar(randomness_source, context, b"MULT")?;
            let r_inv = blinding_field.modular_inverse(&r)
                .ok_or(BlindingError::InverseFailed)?;
            Ok(BlindingParams::Multiplicative { r, r_inv, field: *blinding_field })
        }
        BlindingMode::Additive { mask_width, refresh_interval } => {
            let mask = derive_blinding_bytes(context, b"ADD", *mask_width / 8)?;
            Ok(BlindingParams::Additive { mask, width: *mask_width })
        }
        BlindingMode::SecretSharing { scheme, threshold, num_shares } => {
            let shares = derive_shares(context, scheme, *num_shares)?;
            Ok(BlindingParams::SecretSharing { shares, threshold: *threshold })
        }
        // ... other modes
    }
}

/// Derive blinding randomness deterministically from context
fn derive_blinding_scalar(
    source: &RandomnessSource,
    context: &BlindingContext,
    domain: &[u8],
) -> Result<Scalar, BlindingError> {
    match source {
        RandomnessSource::EpochBoundPRF { domain: base_domain } => {
            // PRF: HMAC-SHA3(input = epoch_seed || validator_id || op_id || domain)
            let mut prf_input = Vec::new();
            prf_input.extend_from_slice(&context.epoch_seed);
            prf_input.extend_from_slice(&context.validator_id.to_le_bytes());
            prf_input.extend_from_slice(&context.operation_id);
            prf_input.extend_from_slice(base_domain);
            prf_input.extend_from_slice(domain);
            
            let prf_output = sha3_256(&prf_input);
            Scalar::from_bytes_mod_order_wide(&prf_output)
                .ok_or(BlindingError::ScalarDerivationFailed)
        }
        RandomnessSource::CascadeDerived { layer_index, purpose } => {
            // Use specific cascade layer output as randomness source
            let cascade_input = build_cascade_blinding_input(context, *purpose);
            let cascade_output = execute_cascade_to_layer(
                &cascade_input, 
                *layer_index, 
                &context.cascade_config
            )?;
            Scalar::from_bytes_mod_order_wide(&cascade_output)
                .ok_or(BlindingError::ScalarDerivationFailed)
        }
        RandomnessSource::HardwareTRNG { fallback } => {
            // Hardware TRNG only allowed for non-consensus paths
            if context.consensus_critical {
                // Fallback to deterministic source for consensus operations
                derive_blinding_scalar(fallback, context, domain)
            } else {
                // Use hardware TRNG with deterministic fallback on failure
                hardware_trng_scalar().or_else(|_| derive_blinding_scalar(fallback, context, domain))
            }
        }
    }
}
