/// Blinded memory access with dummy operations
fn execute_memory_blinded(
    opcode: Opcode,
    vm_state: &mut BlindedVMState,
    config: &ObfuscationBlindingConfig,
) -> Result<ExecutionResult, VMError> {
    // 1. Derive deterministic dummy access pattern
    let dummy_pattern = derive_dummy_access_pattern(
        &vm_state.program_counter,
        &vm_state.epoch_blinding_seed,
        config.dummy_ratio,
    )?;
    
    // 2. Execute real + dummy accesses in shuffled order
    let mut accesses = Vec::new();
    accesses.push(MemoryAccess::Real { 
        addr: opcode.target_address(), 
        op: opcode.access_type() 
    });
    accesses.extend(dummy_pattern.iter().map(|dummy_addr| 
        MemoryAccess::Dummy { addr: *dummy_addr }
    ));
    
    // 3. Shuffle accesses deterministically (same shuffle across validators)
    let shuffled = deterministic_shuffle(accesses, &vm_state.access_shuffle_seed)?;
    
    // 4. Execute all accesses (constant-time, no early exit)
    let mut result = None;
    for access in shuffled {
        match access {
            MemoryAccess::Real { addr, op } => {
                // Execute real access (blinded value if sensitive)
                let value = if is_sensitive_address(addr) {
                    apply_value_blinding(vm_state.memory.read(addr), &config.value_blinding)?
                } else {
                    vm_state.memory.read(addr)
                };
                result = Some(process_access_result(value, op));
            }
            MemoryAccess::Dummy { addr } => {
                // Execute dummy access (no side effects, constant-time)
                dummy_memory_access(addr, config.dummy_access_mode);
            }
        }
    }
    
    // 5. Return result of real access (dummy results discarded)
    result.ok_or(VMError::NoRealAccessExecuted)
}
