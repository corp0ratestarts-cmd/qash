### 5.6 Two-Stage Build Pipeline

**Purpose**: Resolve circular dependency between binary hash and embedded measurement.

**Process**:
```bash
# build.rs (platform-agnostic two-stage build)
fn main() {
    let platform = std::env::var("QASH_PLATFORM").unwrap();
    
    // Stage 1: Compile invariant core with placeholder measurement
    let placeholder = [0u8; 32];
    compile_invariant_core(&platform, &placeholder);
    
    // Stage 2: Compute true measurement from Stage 1 binary
    let true_measurement = sha3_256(&read_binary("invariant_core.bin"));
    
    // Stage 3: Patch binary with true measurement
    patch_binary_with_measurement("invariant_core_patched.bin", &true_measurement);
    
    // Stage 4: Emit platform_measurement.rs for runtime use
    std::fs::write(
        "src/hardware/platform_measurement.rs",
        format!("pub const PLATFORM_MEASUREMENT: [u8; 32] = {:?};", true_measurement)
    ).unwrap();
    
    // Stage 5: CI reproducibility gate
    if std::env::var("CI").is_ok() {
        let recompiled = sha3_256(&read_binary("invariant_core_patched.bin"));
        assert_eq!(recompiled, true_measurement, "Build not reproducible!");
    }
}
```

