/// Chunk key derivation (cascade-bound)
pub fn derive_chunk_key_cascade(
    leaf_index: [u8; 48],
    chunk_index: u32,
    cascade_config: &CascadeConfig,
) -> Result<[u8; 32], CascadeError> {
    // Domain-separate for chunk key derivation
    let mut input = Vec::with_capacity(48 + 4 + 20);
    input.extend_from_slice(&leaf_index);
    input.extend_from_slice(&chunk_index.to_le_bytes());
    input.extend_from_slice(b"QASH:CHUNK:KEY:DERIVATION");  // Domain tag
    
    // Execute cascade
    let cascade_root = execute_astronomical_cascade(&input, cascade_config)?;
    
    Ok(cascade_root)  // 32-byte chunk encryption key
}
