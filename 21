### G.4 Injectivity of Cascade-Derived Identifiers

```coq
(* Theorem: Cascade-derived leaf index is injective *)
Theorem cascade_leaf_index_injective :
  forall (cfg : CascadeConfig) 
         (v1 v2 : u64) (e1 e2 : u64) (s1 s2 : word 256),
    cfg_valid cfg →
    (v1 <> v2 ∨ e1 <> e2 ∨ s1 <> s2) →
    cascade_leaf_index cfg v1 e1 s1 = cascade_leaf_index cfg v2 e2 s2 →
    False.
Proof.
  intros cfg v1 v2 e1 e2 s1 s2 H_cfg H_diff H_eq.
  
  (* Unfold cascade_leaf_index definition *)
  unfold cascade_leaf_index in H_eq.
  
  (* Canonical encoding is injective *)
  assert (H_enc_inj : canonical_encode v1 e1 s1 <> canonical_encode v2 e2 s2).
  { destruct H_diff as [Hv | [He | Hs]]; 
    [apply encode_u64_injective | apply encode_u64_injective | apply encode_word256_injective]; 
    assumption. }
  
  (* Cascade execution is deterministic and avalanche-propagating *)
  assert (H_cascade_diff : cascade_output_differs 
            (canonical_encode v1 e1 s1) 
            (canonical_encode v2 e2 s2) cfg).
  { apply cascade_avalanche_property; 
    [apply H_cfg | apply H_enc_inj | apply domain_separators_unique]; assumption. }
  
  (* Contradiction: equal outputs but different inputs *)
  congruence.
Qed.
