impl CascadeChunkAPDU {
    pub fn handle_request(
        &self,
        chunk_store: &CascadeChunkStore,
        responder_tier: PlatformTier,
    ) -> Result<Vec<u8>, NfcError> {
        // Parse request
        let chunk_index = u32::from_le_bytes(self.data[0..4].try_into()?);
        let leaf_index: [u8; 48] = self.data[4..52].try_into()?;
        let purpose = DerivationPurpose::from_u8(self.data[52])?;
        
        // Fetch chunk
        let chunk = chunk_store.get_cascade_bound_chunk(chunk_index, &leaf_index, purpose)
            .ok_or(NfcError::ChunkNotFound)?;
        
        // Adapt proof to requester's tier (optimize payload size)
        let adapted_proof = chunk.cascade_derivation_proof.adapt_for_tier(responder_tier);
        
        // Serialize response
        let mut response = Vec::new();
        response.extend_from_slice(&chunk.data);
        response.extend_from_slice(&adapted_proof.serialize()?);
        response.extend_from_slice(&chunk.merkle_proof.serialize());
        
        Ok(response)
    }
