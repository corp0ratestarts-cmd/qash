/// Types of cryptographic blinding supported in QASH
pub enum BlindingMode {
    /// Multiplicative blinding: x' = x * r (mod q), undo with r⁻¹
    /// Used for: modular inversion, EC scalar operations, Dilithium polynomial mult
    Multiplicative { 
        blinding_field: FiniteField,  // e.g., ML-DSA prime field
        randomness_source: RandomnessSource,  // PRF-derived, epoch-bound
    },
    
    /// Additive masking: x' = x + r (mod q), undo with -r
    /// Used for: shared secret reconstruction, threshold operations
    Additive {
        mask_width: usize,  // bits of masking randomness
        refresh_interval: u32,  // epochs before mask refresh
    },
    
    /// Boolean/Arithmetic masking: split x into shares (x₁, x₂, ..., xₙ)
    /// Used for: S-boxes, nonlinear operations, fault resistance
    SecretSharing {
        scheme: SharingScheme,  // XOR, additive, Shamir, etc.
        threshold: u8,  // min shares to reconstruct
        num_shares: u8,  // total shares generated
    },
    
    /// Randomized projective coordinates: (X:Y:Z) → (λX:λY:λZ)
    /// Used for: elliptic curve operations (if fallback to ECC needed)
    ProjectiveRandomization {
        coordinate_field: FiniteField,
        lambda_derivation: LambdaDerivation,  // How λ is derived deterministically
    },
    
    /// Dummy operation insertion: execute real + decoy ops in random order
    /// Used for: constant-time execution, access pattern obfuscation
    DummyInsertion {
        dummy_ratio: f64,  // ratio of dummy:real operations
        scheduling_prf: [u8; 32],  // PRF seed for dummy placement
    },
}

/// Source of blinding randomness (must be deterministic for consensus)
pub enum RandomnessSource {
    /// PRF-derived from (epoch_seed || validator_id || operation_id)
    EpochBoundPRF { domain: &'static [u8] },
    /// Cascade-derived: use specific cascade layer output as randomness
    CascadeDerived { layer_index: u8, purpose: BlindingPurpose },
    /// Hardware TRNG (only for non-consensus paths, with fallback)
