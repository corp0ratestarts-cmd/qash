pub fn encode_qr_cascade_chunk(chunk: &CascadeBoundCloneChunk) -> Result<QrCode, QREncodeError> {
    // Serialize with cascade proof
    let mut buffer = Vec::new();
    buffer.extend_from_slice(&chunk.index.to_le_bytes());
    buffer.extend_from_slice(&(chunk.data.len() as u16).to_le_bytes());
    buffer.extend_from_slice(&chunk.data);
    buffer.extend_from_slice(&chunk.cascade_derivation_proof.serialize()?);
    buffer.extend_from_slice(&chunk.merkle_proof.serialize());
    
