/// Compute cascade-derived leaf index: bijective, cascade-bound identifier
pub fn compute_cascade_leaf_index(
    validator_id: u64,
    epoch: u64, 
    epoch_seed: [u8; 32],
    cascade_config: &CascadeConfig,
) -> Result<[u8; 48], CascadeError> {
    // Canonical encoding (little-endian, fixed-width)
    let mut input = Vec::with_capacity(48);
    input.extend_from_slice(&validator_id.to_le_bytes());  // 8 bytes
    input.extend_from_slice(&epoch.to_le_bytes());          // 8 bytes  
    input.extend_from_slice(&epoch_seed);                   // 32 bytes
    
    // Execute astronomical cascade
    let cascade_output = execute_astronomical_cascade(&input, cascade_config)?;
    
    // Truncate/expand to 48 bytes deterministically
    let mut result = [0u8; 48];
    result[0..32].copy_from_slice(&cascade_output);
    // Derive remaining 16 bytes from cascade layer 4 output (deterministic)
    let extension = derive_cascade_extension(&input, 4, cascade_config)?;
    result[32..48].copy_from_slice(&extension[0..16]);
    
    Ok(result)
}

